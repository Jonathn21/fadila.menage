---
const { active = '' } = Astro.props;
const links = [
  { href: '/', key: 'accueil', emo: '🏠', label: 'Accueil' },
  { href: '/nos-services', key: 'nos-services', emo: '🧹', label: 'Nos services' },
  { href: '/tarifs', key: 'tarifs', emo: '💶', label: 'Tarifs' },
  { href: '/nous-connaitre', key: 'nous-connaitre', emo: '👋', label: 'Nous connaître' },
  { href: '/rejoindre', key: 'rejoindre', emo: '💼', label: "Rejoindre l'équipe" },
  { href: '/faq', key: 'faq', emo: '❓', label: 'Questions fréquentes' },
];
---
<header class="appbar">
  <div class="wrap appbar-inner">
    <button class="hamb" id="menuBtn" aria-label="Ouvrir le menu" aria-controls="drawer" aria-expanded="false">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
    <a href="/" class="appbar-logo" aria-label="Cocon — accueil">
      <span class="brandmark"><svg viewBox="0 0 32 32" width="30" height="30" fill="none" aria-hidden="true"><path d="M26 5c-11 0-19 6-19 15 0 2 .4 3.8 1.1 5.4C17 26 24 21 26.5 12.5 27.6 9 27.4 6.9 26 5Z" fill="currentColor"/><path d="M9 25C13 17.5 18 12.5 25 8.5" stroke="#E68243" stroke-width="1.8" stroke-linecap="round"/></svg></span>
      <span class="brandname">cocon</span>
    </a>
    <a href="/demander-un-devis" class="appbar-cta">Devis</a>
  </div>
</header>

<div class="scrim" id="scrim"></div>
<aside class="drawer" id="drawer" aria-hidden="true">
  <div class="drawer-top">
    <span class="drawer-eyebrow">Menu</span>
    <button class="hamb" id="drawerClose" aria-label="Fermer le menu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
  </div>

  <a href="/" class="drawer-brand">
    <span class="brandmark lg"><svg viewBox="0 0 32 32" width="40" height="40" fill="none" aria-hidden="true"><path d="M26 5c-11 0-19 6-19 15 0 2 .4 3.8 1.1 5.4C17 26 24 21 26.5 12.5 27.6 9 27.4 6.9 26 5Z" fill="currentColor"/><path d="M9 25C13 17.5 18 12.5 25 8.5" stroke="#E68243" stroke-width="1.8" stroke-linecap="round"/></svg></span>
    <span><strong>cocon</strong><small>Services à domicile · Lomé</small></span>
  </a>

  <hr class="ddash" />

  <nav class="dnav">
    {links.map((l) => (
      <a href={l.href} class={'dlink' + (active === l.key ? ' active' : '')}>
        <span class="emo">{l.emo}</span>{l.label}
      </a>
    ))}
  </nav>

  <hr class="ddash" />

  <a href="/demander-un-devis" class="dcta">Demander un devis →</a>

  <hr class="ddash" />

  <a href="tel:+22891932723" class="dcontact"><span class="emo">📞</span>+228 91 93 27 23</a>
  <div class="dcontact"><span class="emo">📍</span>Totsi, non loin de l'hôtel Morphée — Lomé</div>
</aside>
