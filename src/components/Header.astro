---
const { active = '' } = Astro.props;
const links = [
  { href: '/', key: 'accueil', emo: '🏀', label: 'Accueil' },
  { href: '/terrains', key: 'terrains', emo: '📍', label: 'Terrains' },
  { href: '/evenements', key: 'evenements', emo: '📅', label: 'Événements' },
  { href: '/equipes', key: 'equipes', emo: '👥', label: 'Équipes' },
  { href: '/defis', key: 'defis', emo: '⚔️', label: 'Défis' },
  { href: '/communaute', key: 'communaute', emo: '📸', label: 'Communauté' },
  { href: '/profil', key: 'profil', emo: '👤', label: 'Mon profil' },
];
---
<header class="appbar">
  <div class="wrap appbar-inner">
    <button class="hamb" id="menuBtn" aria-label="Ouvrir le menu" aria-controls="drawer" aria-expanded="false">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
    <a href="/" class="appbar-logo" aria-label="Basket Togo — accueil">
      <span class="brandmark"><svg viewBox="0 0 32 32" width="30" height="30" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="16" cy="16" r="13"/><path d="M16 3v26M3 16h26"/><path d="M7 6c4 3.5 5.5 6.5 5.5 10S11 22.5 7 26"/><path d="M25 6c-4 3.5-5.5 6.5-5.5 10S21 22.5 25 26"/></svg></span>
      <span class="brandname">Basket&nbsp;Togo</span>
    </a>
    <a href="/connexion" class="appbar-cta" id="appbarCta">Connexion</a>
  </div>
</header>

<div class="scrim" id="scrim"></div>
<aside class="drawer" id="drawer" aria-hidden="true">
  <div class="drawer-top">
    <span class="drawer-eyebrow">Menu</span>
    <button class="hamb" id="drawerClose" aria-label="Fermer le menu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
  </div>

  <a href="/" class="drawer-brand">
    <span class="brandmark lg"><svg viewBox="0 0 32 32" width="40" height="40" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="16" cy="16" r="13"/><path d="M16 3v26M3 16h26"/><path d="M7 6c4 3.5 5.5 6.5 5.5 10S11 22.5 7 26"/><path d="M25 6c-4 3.5-5.5 6.5-5.5 10S21 22.5 25 26"/></svg></span>
    <span><strong>Basket Togo</strong><small>La communauté du basket togolais</small></span>
  </a>

  <hr class="ddash" />

  <nav class="dnav">
    {links.map((l) => (
      <a href={l.href} class={'dlink' + (active === l.key ? ' active' : '')}>
        <span class="emo">{l.emo}</span>{l.label}
      </a>
    ))}
  </nav>

  <hr class="ddash" />

  <a href="/connexion" class="dcta" id="drawerCta">Créer un compte →</a>

  <hr class="ddash" />

  <a href="/connexion" class="dcontact" id="authAction"><span class="emo">🔑</span>Se connecter</a>
  <div class="dcontact"><span class="emo">📍</span>Lomé, Togo</div>
</aside>

<script>
  import { getUser, signOut } from '../lib/auth.js';
  function render() {
    const u = getUser();
    const cta = document.getElementById('appbarCta');
    const dcta = document.getElementById('drawerCta');
    const authAction = document.getElementById('authAction');
    if (u) {
      const initial = (u.pseudo || u.email || '?').charAt(0).toUpperCase();
      if (cta) {
        cta.href = '/profil';
        cta.className = 'appbar-user';
        cta.innerHTML = '<span class="av">' + initial + '</span><span class="lbl">' + u.pseudo + '</span>';
      }
      if (dcta) { dcta.href = '/profil'; dcta.textContent = 'Mon profil →'; }
      if (authAction) {
        authAction.href = '#';
        authAction.innerHTML = '<span class="emo">🚪</span>Se déconnecter';
        authAction.addEventListener('click', (e) => { e.preventDefault(); signOut(); location.href = '/'; });
      }
    }
  }
  render();
  window.addEventListener('bt-auth', render);
</script>
