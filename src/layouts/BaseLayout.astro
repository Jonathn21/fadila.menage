---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const {
  title = 'Fadila Ménage · Lomé',
  description = "Fadila Ménage — placement de personnel de maison, nettoyage professionnel et paniers-cadeaux à Lomé, depuis 2017.",
  active = '',
} = Astro.props;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />
  </head>
  <body>
    <Header active={active} />
    <slot />
    <Footer />
    <script>
      // Menu burger (mobile)
      const burger = document.getElementById('burger');
      const nav = document.getElementById('nav');
      if (burger && nav) {
        burger.addEventListener('click', () => nav.classList.toggle('open'));
        nav.querySelectorAll('a').forEach((a) =>
          a.addEventListener('click', () => nav.classList.remove('open'))
        );
      }
      // Diaporama du héros (fondu enchaîné)
      const heroBg = document.querySelector('.hero-bg');
      if (heroBg) {
        const slides = [...heroBg.querySelectorAll('img')];
        if (slides.length > 1) {
          let i = 0;
          setInterval(() => {
            slides[i].classList.remove('on');
            i = (i + 1) % slides.length;
            slides[i].classList.add('on');
          }, 5000);
        }
      }
      // Header : ombre douce dès qu'on défile
      const mast = document.querySelector('header.masthead');
      if (mast) {
        const onScroll = () => mast.classList.toggle('scrolled', window.scrollY > 8);
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });
      }
      // Animations au scroll (avec cascade entre voisins)
      const io = new IntersectionObserver(
        (es) => {
          es.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
      );
      document.querySelectorAll('.reveal').forEach((el) => {
        const sibs = [...el.parentElement.children].filter((c) =>
          c.classList.contains('reveal')
        );
        const i = sibs.indexOf(el);
        if (i > 0) el.style.transitionDelay = i * 70 + 'ms';
        io.observe(el);
      });
      // Compteurs animés
      const counters = document.querySelectorAll('.stat b[data-count]');
      if (counters.length) {
        const cio = new IntersectionObserver(
          (es) => {
            es.forEach((e) => {
              if (!e.isIntersecting) return;
              const el = e.target;
              const target = +el.dataset.count;
              const suf = el.dataset.suffix || '';
              let cur = 0;
              const step = Math.max(1, Math.round(target / 60));
              const t = setInterval(() => {
                cur += step;
                if (cur >= target) {
                  cur = target;
                  clearInterval(t);
                }
                el.textContent = cur + suf;
              }, 22);
              cio.unobserve(el);
            });
          },
          { threshold: 0.5 }
        );
        counters.forEach((c) => cio.observe(c));
      }
    </script>
  </body>
</html>
