---
import BaseLayout from '../layouts/BaseLayout.astro';
import Terrains from '../components/Terrains.jsx';
---
<BaseLayout title="Terrains — Basket Togo" active="terrains">
  <section class="pagehead">
    <div class="wrap"><span class="label">Où jouer</span><h1>Terrains <i class="fa-solid fa-location-dot" style="color:var(--energy)"></i></h1><p>Trouve un terrain près de chez toi, avec le quartier, la surface et les infos pratiques.</p></div>
  </section>
  <section><div class="wrap">
    <Terrains client:load />
  </div></section>
</BaseLayout>
