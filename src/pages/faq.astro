---
import BaseLayout from '../layouts/BaseLayout.astro';

const faqs = [
  { q: 'Où êtes-vous situés ?', a: "Nos bureaux se trouvent à Totsi, non loin de l'hôtel Morphée, à Lomé (05 BP 155). Nous intervenons dans toute la ville et ses environs." },
  { q: 'Quels services proposez-vous ?', a: "Aide-ménagère, nounou et baby-sitting, cuisinier, chauffeur, nettoyage professionnel de bureaux, produits d'entretien et paniers-cadeaux — pour les particuliers comme pour les entreprises." },
  { q: 'Comment se déroule une demande ?', a: "Vous nous décrivez votre besoin via le formulaire ou par téléphone. Nous vous proposons un devis, puis nous vous présentons le personnel formé et vérifié correspondant." },
  { q: 'Votre personnel est-il formé et vérifié ?', a: "Oui. Chaque agent est recruté sur des critères stricts, formé selon nos méthodes et fait l'objet d'une vérification de ses antécédents et de ses références." },
  { q: 'Quels sont vos tarifs ?', a: "Nos tarifs dépendent de la prestation, du rythme et de la durée. Nous établissons un devis clair et sans engagement sous 24 h." },
  { q: 'Travaillez-vous avec les entreprises ?', a: "Oui. Nous assurons le nettoyage professionnel de bureaux, de commerces et de locaux, en prestation ponctuelle ou en contrat régulier." },
  { q: "Sous quel délai obtient-on une réponse ?", a: "Nous nous engageons à répondre à toute demande sous 24 h." },
  { q: 'Comment postuler pour travailler chez Cocon ?', a: "Rendez-vous sur la page « Rejoignez notre équipe » et envoyez-nous un message : nous étudions chaque candidature avec attention." },
];
---
<BaseLayout title="FAQ — Cocon · Lomé">
  <section class="pagehead has-drops"><div class="drops" aria-hidden="true"><span class="drop d-teal s3" style="top:-28px;right:9%"></span><span class="drop d-amber s2" style="bottom:16%;right:18%"></span><span class="drop d-rose s1" style="top:34%;right:4%"></span></div><div class="wrap"><span class="label">Aide</span><h1>Foire aux questions</h1><p>Les réponses aux questions les plus fréquentes des familles et des entreprises.</p></div></section>
  <section class="has-drops"><div class="drops" aria-hidden="true"><span class="drop d-blue s2" style="top:6%;left:4%"></span><span class="drop d-plum s1" style="bottom:12%;right:5%"></span></div><div class="wrap faq" style="max-width:860px;position:relative;z-index:2">
    {faqs.map((f) => (
      <details class="reveal"><summary>{f.q}</summary><div class="ans">{f.a}</div></details>
    ))}
    <div style="margin-top:28px"><a href="/demander-un-devis" class="btn btn-gold">Demandez un devis <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a></div>
  </div></section>
</BaseLayout>
