---
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = [
  {
    tag: 'Familles',
    kicker: 'Guide pratique',
    title: "Cinq questions à poser avant d'embaucher une nounou",
    excerpt: "Les points essentiels à vérifier pour recruter en confiance et éviter les mauvaises surprises.",
    img: 'https://images.unsplash.com/photo-1741940365437-e55b919a89d3?fm=jpg&q=70&w=900&auto=format&fit=crop',
  },
  {
    tag: 'Maison',
    kicker: 'Conseil',
    title: "Un intérieur impeccable : la bonne routine d'entretien",
    excerpt: "Nos astuces pour garder une maison propre et agréable au quotidien, sans y passer ses journées.",
    img: 'https://images.unsplash.com/photo-1735792339621-2846f164b78f?fm=jpg&q=70&w=900&auto=format&fit=crop',
  },
  {
    tag: 'Recrutement',
    kicker: 'Candidates',
    title: "Travailler chez Fadila Ménage : constituer un bon dossier",
    excerpt: "Références, pièces, présentation : comment mettre toutes les chances de votre côté.",
    img: 'https://images.unsplash.com/photo-1686902711018-03d075fbd77b?fm=jpg&q=70&w=900&auto=format&fit=crop',
  },
];
---
<BaseLayout title="Blog — Fadila Ménage · Lomé" active="blog">
  <section class="pagehead"><div class="wrap"><span class="label">Actualités & conseils</span><h1>Blog</h1><p>Nos repères pratiques pour les particuliers, les entreprises et le personnel de maison.</p></div></section>
  <section><div class="wrap"><div class="news">
    {posts.map((p) => (
      <article class="art reveal">
        <div class="thumb"><span class="tag">{p.tag}</span><img src={p.img} alt="" loading="lazy" /></div>
        <div class="body">
          <span class="date">{p.kicker}</span>
          <h3>{p.title}</h3>
          <p>{p.excerpt}</p>
          <span class="more">Lire l'article <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span>
        </div>
      </article>
    ))}
  </div></div></section>
</BaseLayout>
