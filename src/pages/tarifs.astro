---
import BaseLayout from '../layouts/BaseLayout.astro';

const grille = [
  { emo: '🧹', a: 'a-orange', t: 'Aide-ménagère', p: 'À partir de 2 000 F', u: '/ heure' },
  { emo: '🧽', a: 'a-teal', t: 'Grand ménage / ponctuel', p: 'Sur devis', u: 'selon la surface' },
  { emo: '🍼', a: 'a-rose', t: 'Nounou & garde', p: 'À partir de 30 000 F', u: '/ mois (temps partiel)' },
  { emo: '🍳', a: 'a-amber', t: 'Cuisinier', p: 'Sur devis', u: 'ponctuel ou régulier' },
  { emo: '🚗', a: 'a-blue', t: 'Chauffeur', p: 'Sur devis', u: 'à l\'heure ou au mois' },
  { emo: '🎁', a: 'a-plum', t: 'Panier-cadeau', p: 'À partir de 15 000 F', u: 'selon le contenu' },
];
---
<BaseLayout title="Tarifs — Cocon · Lomé" active="tarifs">
  <section class="pagehead">
    <div class="wrap"><span class="label">Tarifs</span><h1>Des prix clairs 💶</h1><p>Chaque devis est <strong>gratuit et personnalisé</strong>. Vous ne payez que ce dont vous avez besoin, sans engagement.</p></div>
  </section>

  <!-- PRINCIPE -->
  <section class="has-drops">
    <div class="drops" aria-hidden="true"><span class="drop d-teal s2" style="top:8%;left:5%"></span><span class="drop d-orange s1" style="bottom:12%;right:6%"></span></div>
    <div class="wrap">
      <div class="proc">
        <div class="pstep reveal"><div class="pn">01</div><h3>Vous décrivez votre besoin</h3><p>Service, rythme (ponctuel, hebdomadaire, temps plein) et durée souhaités.</p></div>
        <div class="pstep reveal"><div class="pn">02</div><h3>Devis gratuit sous 24 h</h3><p>Un prix clair, détaillé et sans engagement — vous décidez ensuite.</p></div>
        <div class="pstep reveal"><div class="pn">03</div><h3>Vous payez à la prestation</h3><p>Conditions transparentes dès le départ, aucune surprise en cours de route.</p></div>
      </div>
    </div>
  </section>

  <!-- GRILLE -->
  <section><div class="wrap">
    <div class="sec-head reveal"><span class="label">Grille indicative</span><h2>Combien ça coûte ?</h2><p>Tarifs donnés à titre indicatif — le prix final dépend de la prestation, du rythme et de la durée.</p></div>
    <div class="svc-grid">
      {grille.map((g) => (
        <div class={'svc reveal ' + g.a}>
          <div class="svc-ic emoji">{g.emo}</div>
          <h3>{g.t}</h3>
          <div class="price">{g.p}</div>
          <div class="price-u">{g.u}</div>
        </div>
      ))}
    </div>
    <p class="req-note" style="text-align:left;margin-top:16px">💡 Les tarifs ci-dessus sont indicatifs. Demandez votre devis gratuit pour un prix exact adapté à votre situation.</p>
  </div></section>

  <!-- GARANTIES -->
  <section><div class="wrap">
    <div class="card reveal" style="border-radius:26px;padding:32px 28px">
      <span class="label">Nos garanties</span>
      <h2 style="font-size:clamp(1.5rem,3vw,2rem);font-weight:800;margin-top:8px">Pourquoi c'est un bon choix</h2>
      <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:16px 24px;margin-top:18px" class="guarantees">
        <div style="display:flex;gap:12px"><span style="font-size:22px">✅</span><span><strong>Agents formés &amp; vérifiés</strong><br /><span style="color:rgba(255,255,255,.82)">Sélection rigoureuse, antécédents contrôlés.</span></span></div>
        <div style="display:flex;gap:12px"><span style="font-size:22px">🤝</span><span><strong>Sans engagement</strong><br /><span style="color:rgba(255,255,255,.82)">Devis gratuit, vous restez libre.</span></span></div>
        <div style="display:flex;gap:12px"><span style="font-size:22px">🔄</span><span><strong>Remplacement rapide</strong><br /><span style="color:rgba(255,255,255,.82)">Un imprévu ? Nous réagissons vite.</span></span></div>
        <div style="display:flex;gap:12px"><span style="font-size:22px">📞</span><span><strong>Un suivi dédié</strong><br /><span style="color:rgba(255,255,255,.82)">Une équipe joignable, à votre écoute.</span></span></div>
      </div>
    </div>
  </div></section>

  <!-- CTA -->
  <section><div class="wrap">
    <div class="ctacard reveal">
      <h2>Recevez votre devis gratuit</h2>
      <p>Dites-nous votre besoin — réponse sous 24 h, sans engagement.</p>
      <a href="/demander-un-devis" class="btn btn-white">Demander un devis →</a>
    </div>
  </div></section>
</BaseLayout>
