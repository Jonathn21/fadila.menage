---
import BaseLayout from '../layouts/BaseLayout.astro';
import Auth from '../components/Auth.jsx';
---
<BaseLayout title="Connexion — Basket Togo" active="connexion">
  <section class="pagehead">
    <div class="wrap"><span class="label">Ton compte</span><h1>Rejoins Basket Togo <i class="fa-solid fa-basketball" style="color:var(--energy)"></i></h1><p>Crée ton compte pour rejoindre une équipe, lancer des défis et partager tes matchs.</p></div>
  </section>

  <section><div class="wrap" style="max-width:520px">
    <Auth client:load />
  </div></section>
</BaseLayout>
