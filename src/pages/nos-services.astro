---
import BaseLayout from '../layouts/BaseLayout.astro';

const services = [
  { emo: '🧹', a: 'a-orange', t: 'Aide-ménagère', d: "L'entretien de votre intérieur, au quotidien ou ponctuellement, avec soin et discrétion." },
  { emo: '🍼', a: 'a-rose', t: 'Nounou & baby-sitting', d: 'Une garde attentive et fiable pour vos enfants — un soir, à temps partiel ou plein.' },
  { emo: '🍳', a: 'a-amber', t: 'Cuisinier', d: 'Des repas préparés chez vous, pour le quotidien comme pour vos réceptions.' },
  { emo: '🚗', a: 'a-blue', t: 'Chauffeur', d: 'Un chauffeur ponctuel et prudent pour vos déplacements à Lomé.' },
  { emo: '🌿', a: 'a-green', t: 'Jardinier', d: 'Entretien des espaces verts et petits travaux extérieurs.' },
  { emo: '🧽', a: 'a-teal', t: 'Nettoyage professionnel', d: 'Bureaux, commerces et locaux : entretien planifié, ponctuel ou en contrat.' },
];
---
<BaseLayout title="Nos services — Cocon · Lomé" active="nos-services">
  <section class="pagehead">
    <div class="wrap"><span class="label">Nos prestations</span><h1>Nos services 🧡</h1><p>Un personnel formé, vérifié et accompagné dans la durée — pour les familles comme pour les entreprises.</p></div>
  </section>

  <!-- LES MÉTIERS -->
  <section class="has-drops">
    <div class="drops" aria-hidden="true"><span class="drop d-teal s2" style="top:6%;right:6%"></span><span class="drop d-orange s1" style="bottom:10%;left:4%"></span></div>
    <div class="wrap">
      <div class="svc-grid">
        {services.map((s) => (
          <div class={'svc reveal ' + s.a}>
            <div class="svc-ic emoji">{s.emo}</div>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3 PÔLES -->
  <section><div class="wrap">
    <div class="sec-head reveal"><span class="label">Notre métier</span><h2>Trois pôles, un seul objectif</h2></div>
    <div class="svc-detail">
      <div class="item reveal"><div class="ic emoji">🧽</div><h3>Nettoyage & entretien</h3><p>Nettoyage ponctuel ou par fréquence, au domicile comme aux bureaux : dépoussiérage, sols, sanitaires, vitres, électroménager, vaisselle… selon vos besoins.</p></div>
      <div class="item reveal" style="background:var(--gold-deep);border-color:var(--gold-deep)"><div class="ic emoji" style="background:rgba(255,255,255,.18)">👥</div><h3 style="color:#fff">Personnel de ménage</h3><p style="color:#F4E7D9">Aides-ménagères, nounous, cuisiniers, chauffeurs et jardiniers — sélectionnés avec rigueur, formés à nos méthodes, puis placés et suivis chez vous.</p></div>
      <div class="item reveal" style="background:#0C9C8B;border-color:#0C9C8B"><div class="ic emoji" style="background:rgba(255,255,255,.18)">🎁</div><h3 style="color:#fff">Paniers-cadeaux</h3><p style="color:#E4F3F0">Champagne, fleurs, chocolats, fruits, cartes de vœux… Composez un joli panier pour un proche, quelle que soit l'occasion.</p></div>
      <div class="item reveal"><div class="ic emoji">🌍</div><h3>Insertion professionnelle</h3><p>Nous formons et employons localement, en priorité des jeunes, des femmes et des personnes éloignées de l'emploi — pour un service de qualité et un impact social réel.</p></div>
    </div>
    <div style="margin-top:34px;display:flex;gap:12px;flex-wrap:wrap">
      <a href="/demander-un-devis" class="btn btn-white">Demander un devis →</a>
      <a href="/faq" class="btn btn-ghost">Questions fréquentes</a>
    </div>
  </div></section>

  <!-- TÉMOIGNAGE -->
  <section><div class="wrap">
    <div class="ctacard reveal">
      <div style="font-size:34px;line-height:1">💬</div>
      <p style="font-family:'Archivo';font-weight:600;font-style:italic;font-size:1.3rem;line-height:1.45;color:#fff;max-width:640px;margin:14px auto 0">« Nous sommes très ravis de la disponibilité et du sérieux de votre équipe. »</p>
    </div>
  </div></section>
</BaseLayout>
