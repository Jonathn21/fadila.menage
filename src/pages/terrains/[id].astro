---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { terrains } from '../../lib/data.js';

export function getStaticPaths() {
  return terrains.map((t) => ({ params: { id: t.id }, props: { t } }));
}

const { t } = Astro.props;
const mapQ = encodeURIComponent(t.quartier + ', Togo');
---
<BaseLayout title={t.nom + ' — Basket Togo'} active="terrains">
  <section class="detail-hero">
    <img src={t.img} alt={t.nom} />
    <div class="detail-hero-overlay" aria-hidden="true"></div>
    <a href="/terrains" class="detail-back">← Terrains</a>
    <div class="detail-hero-copy">
      <span class={'badge ' + (t.ouvert ? 'ok' : 'off')}>{t.ouvert ? 'Ouvert' : 'Fermé'}</span>
      <h1>{t.nom}</h1>
      <p><i class="fa-solid fa-location-dot"></i> {t.quartier}</p>
    </div>
  </section>

  <section><div class="wrap" style="max-width:720px">
    <div class="court-meta big">
      <span><i class="fa-solid fa-basketball"></i> {t.paniers} panier{t.paniers > 1 ? 's' : ''}</span>
      <span><i class="fa-solid fa-road"></i> {t.surface}</span>
      <span><i class="fa-solid fa-star"></i> {t.note.toFixed(1)}</span>
    </div>

    <h2 class="detail-section-t">Emplacement</h2>
    <div class="map-embed">
      <iframe src={`https://www.google.com/maps?q=${mapQ}&output=embed`} loading="lazy" title={'Carte — ' + t.nom}></iframe>
    </div>

    <h2 class="detail-section-t">Photos</h2>
    <div class="detail-gallery">
      <img src={t.img} alt={t.nom} loading="lazy" />
    </div>

    <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:26px">
      <a href="/communaute" class="btn btn-white">Voir les posts →</a>
      <a href="/defis" class="btn btn-ghost">Lancer un défi ici</a>
    </div>
  </div></section>
</BaseLayout>
