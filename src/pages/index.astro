---
import BaseLayout from '../layouts/BaseLayout.astro';

const quick = [
  { emo: '📍', label: 'Terrains', href: '/terrains' },
  { emo: '📅', label: 'Événements', href: '/evenements' },
  { emo: '👥', label: 'Équipes', href: '/equipes' },
  { emo: '⚔️', label: 'Défis', href: '/defis' },
  { emo: '📸', label: 'Feed', href: '/communaute' },
];

const features = [
  { emo: '📍', a: 'a-orange', t: 'Trouve un terrain', d: 'Les terrains près de chez toi, avec photos, quartier et infos pratiques.', href: '/terrains' },
  { emo: '👥', a: 'a-blue', t: 'Crée ou rejoins une équipe', d: 'Monte ton équipe, invite tes potes, gère tes membres.', href: '/equipes' },
  { emo: '⚔️', a: 'a-teal', t: 'Lance un défi', d: 'Défie une autre équipe, fixez la date et le terrain. Que le meilleur gagne.', href: '/defis' },
  { emo: '📅', a: 'a-amber', t: 'Événements & tournois', d: 'Entraînements, matchs et tournois à venir dans tout le Togo.', href: '/evenements' },
  { emo: '📸', a: 'a-rose', t: 'Partage & réagis', d: 'Poste tes photos et vidéos, like et commente celles de la communauté.', href: '/communaute' },
  { emo: '🔔', a: 'a-plum', t: 'Reste notifié', d: 'Défis reçus, matchs, réactions : tu es toujours au courant.', href: '/connexion' },
];

const feed = [
  { ini: 'K', accent: 'a-orange', name: 'Kossi A.', team: 'Lomé Ballers', txt: 'Gros match hier au terrain de Bè 🔥 Merci à tous ceux qui sont venus !', likes: 42, com: 8, emo: '🏀' },
  { ini: 'A', accent: 'a-blue', name: 'Ama D.', team: 'Kara Warriors', txt: 'On lance un défi aux Lomé Ballers 💪 Qui est chaud ?', likes: 67, com: 21, emo: '⚔️' },
  { ini: 'M', accent: 'a-teal', name: 'Mensah T.', team: 'Sokodé Storm', txt: 'Tournoi 3x3 ce week-end à Sokodé. Inscriptions ouvertes 🏆', likes: 30, com: 5, emo: '🏆' },
];
---
<BaseLayout title="Basket Togo — La communauté du basket togolais" active="accueil">
  <!-- HERO -->
  <section class="apphero has-drops">
    <div class="drops" aria-hidden="true">
      <span class="drop d-teal s2" style="top:12%;left:3%"></span>
      <span class="drop d-orange s1" style="bottom:14%;left:8%"></span>
    </div>
    <div class="wrap">
      <div class="hero-copy">
        <span class="label">Communauté · Lomé & tout le Togo</span>
        <h1>Le basket togolais,<br /><span class="hl">enfin réuni.</span></h1>
        <p>Trouve un terrain, rejoins une équipe, lance un défi, partage tes matchs. Toute la scène basket du Togo dans une seule appli.</p>
        <div class="hero-cta">
          <a href="/connexion" class="btn btn-white">Créer un compte →</a>
          <a href="/terrains" class="btn btn-ghost">Explorer</a>
        </div>
      </div>
      <div class="hero-visual" aria-hidden="true">
        <span class="hero-emoji">🏀</span>
        <span class="drop d-teal s2" style="top:2%;right:4%"></span>
        <span class="drop d-orange s1" style="bottom:4%;left:6%"></span>
      </div>
    </div>
  </section>

  <!-- ACTIONS RAPIDES -->
  <section class="quickwrap"><div class="wrap">
    <div class="quick">
      {quick.map((q) => (
        <a href={q.href} class="qa"><span class="disc">{q.emo}</span><span>{q.label}</span></a>
      ))}
    </div>
  </div></section>

  <!-- FONCTIONNALITÉS -->
  <section class="has-drops">
    <div class="drops" aria-hidden="true">
      <span class="drop d-rose s2" style="top:6%;right:6%"></span>
      <span class="drop d-teal s1" style="bottom:10%;left:4%"></span>
    </div>
    <div class="wrap">
      <div class="sec-head reveal"><span class="label">Ce que tu peux faire</span><h2>Tout le basket, au même endroit</h2><p>Une plateforme pensée pour les joueurs, les équipes et les fans.</p></div>
      <div class="svc-grid">
        {features.map((f) => (
          <a href={f.href} class={'svc reveal ' + f.a}>
            <div class="svc-ic emoji">{f.emo}</div>
            <h3>{f.t}</h3>
            <p>{f.d}</p>
            <span class="more">Découvrir →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- COMMENT ÇA MARCHE -->
  <section><div class="wrap">
    <div class="sec-head reveal"><span class="label">En 3 étapes</span><h2>Rejoins le mouvement</h2></div>
    <div class="proc">
      <div class="pstep reveal"><div class="pn">01</div><h3>Crée ton compte</h3><p>Gratuit, en une minute. Choisis ton pseudo et ton quartier.</p></div>
      <div class="pstep reveal"><div class="pn">02</div><h3>Rejoins une équipe</h3><p>Trouve ton équipe ou crée la tienne et invite tes potes.</p></div>
      <div class="pstep reveal"><div class="pn">03</div><h3>Joue & partage</h3><p>Lance des défis, joue tes matchs, poste tes meilleurs moments.</p></div>
    </div>
  </div></section>

  <!-- FEED (aperçu démo) -->
  <section class="has-drops">
    <div class="drops" aria-hidden="true"><span class="drop d-amber s2" style="top:8%;right:6%"></span><span class="drop d-teal s1" style="bottom:12%;left:5%"></span></div>
    <div class="wrap">
      <div class="sec-head center reveal"><span class="label">Communauté</span><h2>Ça bouge en ce moment</h2></div>
      <div class="reviews">
        {feed.map((p) => (
          <figure class={'review reveal ' + p.accent}>
            <figcaption style="margin-top:0"><span class="rv-ini">{p.ini}</span><span><b>{p.name}</b><small>{p.team}</small></span></figcaption>
            <blockquote>{p.emo} {p.txt}</blockquote>
            <div class="stars" style="color:rgba(255,255,255,.8);font-family:'Archivo';font-weight:700;font-size:.9rem;letter-spacing:0">❤️ {p.likes} · 💬 {p.com}</div>
          </figure>
        ))}
      </div>
      <div style="text-align:center;margin-top:28px"><a href="/communaute" class="btn btn-white">Voir le feed →</a></div>
    </div>
  </section>

  <!-- CTA -->
  <section><div class="wrap">
    <div class="ctacard reveal">
      <div style="font-size:40px;line-height:1">🏀</div>
      <h2>Prêt à entrer sur le terrain ?</h2>
      <p>Rejoins des centaines de joueurs togolais. C'est gratuit, et ça commence maintenant.</p>
      <a href="/connexion" class="btn btn-white">Créer mon compte →</a>
    </div>
  </div></section>
</BaseLayout>
