---
import BaseLayout from '../layouts/BaseLayout.astro';

const quick = [
  { emo: '🧹', label: 'Ménage' },
  { emo: '🍼', label: 'Nounou' },
  { emo: '🍳', label: 'Cuisinier' },
  { emo: '🚗', label: 'Chauffeur' },
  { emo: '🌿', label: 'Jardin' },
  { emo: '🎁', label: 'Panier' },
];

const services = [
  { emo: '🧹', a: 'a-orange', t: 'Aide-ménagère', d: "L'entretien de votre intérieur, au quotidien ou ponctuellement, avec soin et discrétion." },
  { emo: '🍼', a: 'a-rose', t: 'Nounou & baby-sitting', d: 'Une garde attentive et fiable pour vos enfants — un soir, à temps partiel ou plein.' },
  { emo: '🍳', a: 'a-amber', t: 'Cuisinier', d: 'Des repas préparés chez vous, pour le quotidien comme pour vos réceptions.' },
  { emo: '🚗', a: 'a-blue', t: 'Chauffeur', d: 'Un chauffeur ponctuel et prudent pour vos déplacements à Lomé.' },
  { emo: '🧽', a: 'a-teal', t: 'Nettoyage pro', d: 'Bureaux, commerces et locaux : un entretien planifié, ponctuel ou en contrat.' },
  { emo: '🎁', a: 'a-plum', t: 'Paniers-cadeaux', d: 'Des paniers soignés pour toutes les occasions, livrés à un proche.' },
];
---
<BaseLayout title="Accueil — Fadila Ménage · Lomé" active="accueil">
  <!-- HERO -->
  <section class="apphero has-drops">
    <div class="drops" aria-hidden="true">
      <span class="drop d-teal s2" style="top:12%;left:3%"></span>
      <span class="drop d-orange s1" style="bottom:14%;left:8%"></span>
    </div>
    <div class="wrap">
      <div class="hero-copy">
        <span class="label">Depuis 2017 · Lomé, Togo</span>
        <h1>Votre quotidien,<br /><span class="hl">entre de bonnes mains.</span></h1>
        <p>Aides-ménagères, nounous, cuisiniers, chauffeurs, nettoyage professionnel et paniers-cadeaux — un personnel formé, vérifié et accompagné.</p>
        <div class="hero-cta">
          <a href="/demander-un-devis" class="btn btn-white">Demander un devis →</a>
          <a href="/nos-services" class="btn btn-ghost">Nos services</a>
        </div>
      </div>
      <div class="hero-visual" aria-hidden="true">
        <div class="cloud"></div>
        <div class="blob"></div>
        <div class="hero-emoji">🧺</div>
        <span class="drop d-teal s2" style="top:8%;right:2%"></span>
        <span class="drop d-orange s1" style="bottom:6%;left:4%"></span>
        <span class="drop d-plum s2" style="top:52%;right:-2%"></span>
      </div>
    </div>
  </section>

  <!-- ACTIONS RAPIDES -->
  <section class="quickwrap"><div class="wrap">
    <div class="quick">
      {quick.map((q) => (
        <a href="/nos-services" class="qa"><span class="disc">{q.emo}</span><span>{q.label}</span></a>
      ))}
    </div>
  </div></section>

  <!-- SERVICES -->
  <section class="has-drops">
    <div class="drops" aria-hidden="true">
      <span class="drop d-rose s2" style="top:6%;right:6%"></span>
      <span class="drop d-teal s1" style="bottom:10%;left:4%"></span>
    </div>
    <div class="wrap">
      <div class="sec-head reveal"><span class="label">Nos prestations</span><h2>Ce que nous faisons pour vous</h2><p>Un personnel formé et vérifié, pour les familles comme pour les entreprises.</p></div>
      <div class="svc-grid">
        {services.map((s) => (
          <a href="/nos-services" class={'svc reveal ' + s.a}>
            <div class="svc-ic emoji">{s.emo}</div>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
            <span class="more">En savoir plus →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CHIFFRES -->
  <section><div class="wrap">
    <div class="statcard reveal">
      <div class="s"><b>97%</b><span>Clients satisfaits</span></div>
      <div class="s"><b>150+</b><span>Agents formés</span></div>
      <div class="s"><b>24h</b><span>Délai de réponse</span></div>
      <div class="s"><b>100+</b><span>Emplois créés</span></div>
    </div>
  </div></section>

  <!-- ENGAGEMENT -->
  <section class="has-drops">
    <div class="drops" aria-hidden="true">
      <span class="drop d-green s2" style="top:14%;left:8%"></span>
      <span class="drop d-amber s1" style="bottom:16%;right:8%"></span>
    </div>
    <div class="wrap">
      <div class="social reveal">
        <div style="font-size:44px;line-height:1;margin-bottom:10px">🌍</div>
        <h2>Une mission sociale</h2>
        <p>Fadila Ménage œuvre pour l'insertion des jeunes, des femmes et des personnes éloignées de l'emploi, et promeut l'éco-nettoyage en Afrique. Plus de 150 jeunes formés depuis 2017.</p>
        <a href="/nous-connaitre" class="btn btn-white" style="margin-top:22px">Nos engagements →</a>
      </div>
    </div>
  </section>

  <!-- CONFIANCE -->
  <section><div class="wrap">
    <div style="background:#fff;border-radius:24px;padding:32px 24px;text-align:center;box-shadow:0 20px 44px -28px rgba(90,40,10,.5)">
      <span class="label" style="color:#C7500F">Ils nous font confiance</span>
      <div style="margin-top:28px;display:flex;flex-wrap:wrap;gap:22px 46px;justify-content:center;align-items:center">
        <img src="/images/partenaires/republique-togolaise.png" alt="République Togolaise" loading="lazy" style="height:72px;width:auto;object-fit:contain" />
        <img src="/images/partenaires/goethe-institut.png" alt="Goethe-Institut" loading="lazy" style="height:44px;width:auto;object-fit:contain" />
        <img src="/images/partenaires/boad.png" alt="BOAD" loading="lazy" style="height:62px;width:auto;object-fit:contain" />
        <img src="/images/partenaires/eres-togo.png" alt="ERES Togo" loading="lazy" style="height:48px;width:auto;object-fit:contain" />
        <img src="/images/partenaires/epam.png" alt="EPAM" loading="lazy" style="height:58px;width:auto;object-fit:contain" />
      </div>
    </div>
  </div></section>

  <!-- CTA -->
  <section><div class="wrap">
    <div class="ctacard reveal">
      <h2>Prêt à vous simplifier la vie ?</h2>
      <p>Dites-nous votre besoin — nous revenons vers vous sous 24 h avec une proposition adaptée, sans engagement.</p>
      <a href="/demander-un-devis" class="btn btn-white">Demander un devis →</a>
    </div>
  </div></section>
</BaseLayout>
