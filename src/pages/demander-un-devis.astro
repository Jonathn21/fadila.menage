---
import BaseLayout from '../layouts/BaseLayout.astro';
import DevisForms from '../components/DevisForms.jsx';
---
<BaseLayout title="Demandez un devis — Fadila Ménage · Lomé">
  <section class="pagehead has-photo">
    <div class="pagehead-media"><img src="/images/services/entete-devis.jpg" alt="Personnel Fadila Ménage" width="1680" height="760" /></div>
    <div class="wrap"><span class="label">Demande de devis</span><h1>Devis</h1><p>Choisissez le formulaire adapté à votre besoin. Nous revenons vers vous sous 24 h avec une proposition adaptée, sans engagement.</p></div>
  </section>

  <section class="has-drops">
    <div class="drops" aria-hidden="true"><span class="drop d-orange s3" style="top:-24px;left:5%"></span><span class="drop d-blue s2" style="top:12%;right:6%"></span><span class="drop d-green s2" style="bottom:10%;left:8%"></span><span class="drop d-rose s1" style="bottom:20%;right:10%"></span></div>
    <div class="wrap">
    <DevisForms client:visible />
  </div></section>

  <section id="contact"><div class="wrap">
    <div class="sec-head reveal"><span class="label">Contact</span><h2>Contactez-nous</h2></div>
    <div class="contact-grid">
      <div class="contact-card reveal">
        <div class="ci"><b>Adresse</b><p>Totsi, non loin de l'hôtel Morphée — 05 BP 155, Lomé, Togo</p></div>
        <div class="ci"><b>Téléphone</b><p>+228 22 25 27 23<br />+228 91 93 27 23<br />+228 97 00 38 53</p></div>
        <div class="ci" style="border-bottom:0"><b>E-mail</b><p>hello@fadilamenage.com</p></div>
        <a href="/demander-un-devis" class="btn btn-gold">Demandez un devis <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
      </div>
      <figure class="map reveal"><img src="/images/locaux-fadila.webp" alt="Les locaux de Fadila Ménage à Totsi, Lomé" width="1360" height="907" loading="lazy" /><figcaption><i class="fa-solid fa-location-dot" aria-hidden="true"></i> Nos locaux à Totsi, Lomé</figcaption></figure>
    </div>
  </div></section>
</BaseLayout>
