---
import BaseLayout from '../layouts/BaseLayout.astro';

const team = [
  { role: 'Direction', icon: 'fa-user-tie' },
  { role: 'Équipe administrative', icon: 'fa-user-gear' },
  { role: 'Aide-ménagère', icon: 'fa-house' },
  { role: 'Nounou', icon: 'fa-baby' },
  { role: 'Cuisinier', icon: 'fa-utensils' },
  { role: 'Chauffeur', icon: 'fa-car' },
  { role: 'Jardinier', icon: 'fa-seedling' },
  { role: 'Agent de nettoyage', icon: 'fa-broom' },
];
---
<BaseLayout title="Nous connaître — Fadila Ménage · Lomé" active="nous-connaitre">
  <section class="pagehead"><div class="wrap"><span class="label">L'agence</span><h1>Nous connaître</h1><p>Depuis 2017, Fadila Ménage œuvre pour apporter du bonheur et de la sérénité dans les foyers togolais.</p></div></section>

  <section class="sec-mist"><div class="wrap">
    <div class="sec-head center reveal"><span class="label">Notre histoire</span><h2>Une aventure lancée en 2017</h2></div>
    <div class="histoire reveal">
      <div class="hist-badge"><b>2017</b><span>Année de lancement</span></div>
      <div class="hist-text">
        <p class="lead-p">Créée en 2017 au sein du Fadila Group, Fadila Ménage est spécialisée dans le placement de personnel de maison, le nettoyage professionnel et la conception de paniers-cadeaux.</p>
        <p>Notre métier ne se limite pas à la mise en relation. Nous sommes à la fois <strong>recruteur, formateur et employeur</strong> : nous sélectionnons nos agents, les formons selon nos méthodes — avec l'appui de partenaires du secteur hôtelier — puis les accompagnons tout au long de leurs missions.</p>
        <p><strong>Notre mission :</strong> apporter le bonheur et la joie dans vos foyers, en vous offrant un personnel fiable, formé et vérifié.</p>
        <a href="/nos-services" class="btn btn-green">Découvrez nos services <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
      </div>
    </div>
  </div></section>

  <section><div class="wrap">
    <div class="sec-head center reveal"><span class="label">À la découverte de nos équipes</span><h2>Celles et ceux qui font Fadila Ménage</h2><p>Fadila Ménage a la chance de compter de nombreux professionnels parmi son équipe. Des aide-ménagères aux nounous en passant par les cuisiniers, chauffeurs et jardiniers, sans oublier l'équipe administrative, chaque membre a pour objectif de satisfaire nos clients. Apprenez à connaître l'équipe et contactez-nous si vous avez des questions.</p></div>
    <div class="team">
      {team.map((m) => (
        <figure class="member reveal"><div class="avatar"><i class={'fa-solid ' + m.icon}></i></div><figcaption><b>{m.role}</b><span>Fadila Ménage</span></figcaption></figure>
      ))}
    </div>
  </div></section>

  <section class="sec-mist"><div class="wrap">
    <div class="feature reveal">
      <div class="fpanel" style="background:var(--teal-deep)">
        <i class="fa-solid fa-spray-can-sparkles gl"></i>
        <h2>Trouver la solution la plus adaptée à vos besoins</h2>
        <p>Nous fournissons toujours un service de qualité, et nous sommes particulièrement fiers des prestations de suivi que nous proposons. Lorsque vous travaillez avec nous, vous profitez de prestations uniques. Nous ne sommes satisfaits de notre travail que lorsque nos clients le sont aussi.</p>
        <a href="/rejoindre" class="btn btn-gold">Rejoignez notre équipe <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
      </div>
      <div class="fimg"><img src="https://images.unsplash.com/photo-1581578731548-c64695cc6952?fm=jpg&q=70&w=1100&auto=format&fit=crop" alt="Nettoyage professionnel" loading="lazy" /></div>
    </div>
  </div></section>
</BaseLayout>
