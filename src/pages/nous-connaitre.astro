---
import BaseLayout from '../layouts/BaseLayout.astro';

const team = [
  'Loukman', 'Dr. Kpelafia', 'John', 'Audrey',
  'Ahmed', 'Silvère', 'Stephane', 'Sandra',
];
---
<BaseLayout title="Nous connaître — Fadila Ménage · Lomé" active="nous-connaitre">
  <section class="pagehead">
    <div class="wrap"><span class="label">L'agence</span><h1>Nous connaître 👋</h1><p>Depuis 2017, Fadila Ménage œuvre pour apporter du bonheur et de la sérénité dans les foyers togolais.</p></div>
  </section>

  <!-- NOTRE HISTOIRE -->
  <section class="has-drops">
    <div class="drops" aria-hidden="true"><span class="drop d-orange s2" style="top:8%;left:5%"></span><span class="drop d-teal s1" style="bottom:12%;right:6%"></span></div>
    <div class="wrap">
      <div class="card reveal" style="border-radius:26px;padding:34px 30px">
        <span class="label">Notre histoire</span>
        <h2 style="font-size:clamp(1.6rem,3vw,2.2rem);font-weight:800;margin-top:10px">Une aventure lancée en 2017</h2>
        <p class="lead-p" style="margin-top:16px;font-size:1.1rem;color:#fff">Créée en 2017 au sein du Fadila Group, Fadila Ménage est spécialisée dans le placement de personnel de maison, le nettoyage professionnel et la conception de paniers-cadeaux.</p>
        <p style="margin-top:12px;color:rgba(255,255,255,.86)">Notre métier ne se limite pas à la mise en relation. Nous sommes à la fois <strong style="color:#fff">recruteur, formateur et employeur</strong> : nous sélectionnons nos agents, les formons selon nos méthodes — avec l'appui de partenaires du secteur hôtelier — puis les accompagnons tout au long de leurs missions.</p>
        <p style="margin-top:12px;color:rgba(255,255,255,.86)"><strong style="color:#fff">Notre mission :</strong> apporter le bonheur et la joie dans vos foyers, avec un personnel fiable, formé et vérifié.</p>
        <div style="display:flex;flex-wrap:wrap;gap:10px 26px;align-items:center;margin-top:22px">
          <div style="display:flex;align-items:baseline;gap:10px"><b style="font-family:'Archivo';font-weight:800;font-size:2.2rem;color:#fff">2017</b><span style="color:rgba(255,255,255,.78)">année de lancement</span></div>
          <a href="/nos-services" class="btn btn-white">Découvrez nos services →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ÉQUIPE -->
  <section class="has-drops">
    <div class="drops" aria-hidden="true"><span class="drop d-plum s2" style="top:10%;right:8%"></span><span class="drop d-green s1" style="bottom:14%;left:10%"></span></div>
    <div class="wrap">
      <div class="sec-head center reveal"><span class="label">Notre équipe</span><h2>Celles et ceux qui font Fadila Ménage</h2><p>Des aides-ménagères aux nounous, cuisiniers, chauffeurs et jardiniers, sans oublier l'équipe administrative — chacun a pour objectif de vous satisfaire.</p></div>
      <div class="team">
        {team.map((name) => (
          <figure class="member reveal"><div class="avatar"><span class="ini">{name.replace('Dr. ', '').charAt(0)}</span></div><figcaption><b>{name}</b><span>Équipe Fadila Ménage</span></figcaption></figure>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section><div class="wrap">
    <div class="ctacard reveal">
      <div style="font-size:38px;line-height:1">✨</div>
      <h2>Trouvons la solution la plus adaptée à vos besoins</h2>
      <p>Nous ne sommes satisfaits de notre travail que lorsque vous l'êtes aussi. Rejoignez une équipe qui accompagne ses agents dans la durée.</p>
      <a href="/rejoindre" class="btn btn-white">Rejoignez notre équipe →</a>
    </div>
  </div></section>
</BaseLayout>
